# Copy to .secrets.env (gitignored). Never commit real tokens.
TELEGRAM_BOT_TOKEN=
DASHBOARD_KEY=change-me
BIND_CODE=abcd1234
# Optional: MAX tokens if you want cloud-side polling.
# Default path talks to MAX via SSH on each prod host, tokens stay there.
X5_MAX_BOT_TOKEN=
CHIZ_MAX_BOT_TOKEN=
PM_MAX_BOT_TOKEN=
# Telegram numeric user ids allowed to run infra commands (comma-separated).
# Empty = first successful /start BIND_CODE becomes admin.
TELEGRAM_ADMIN_IDS=
